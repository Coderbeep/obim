{
  "name": "obim",
  "version": "0.9.0-beta-1",
  "description": "Markdown WYSIWYG editor with live inline preview",
  "license": "MIT",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test:file-explorer": "vitest run tests/file-explorer tests/file-explorer.test.ts tests/file-import.test.ts tests/workspace-file-service.test.ts tests/mime-types.test.ts tests/path-utils.test.ts tests/store-lifecycle.test.ts tests/workspace-mutations.test.ts tests/workspace-paths.test.ts",
    "test:file-explorer:coverage": "vitest run --coverage --maxWorkers=4",
    "test": "vitest run",
    "design-graph": "vite --config vite.design-graph.config.ts --mode design-graph",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:tests",
    "verify": "pnpm run typecheck && pnpm run lint:check && pnpm test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "build:win": "pnpm run build && electron-builder --win --config",
    "build:mac": "pnpm run build && electron-builder --mac --config",
    "build:linux": "pnpm run build && electron-builder --linux --config"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^2.0.0",
    "markdown-it": "^14.3.1",
    "mime-types": "^3.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.6.2",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/search": "^6.5.5",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.32.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@pierre/icons": "0.7.0",
    "@pierre/trees": "1.0.0-beta.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.14.202",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@uiw/react-codemirror": "^4.23.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror-markdown-tables": "1.0.1",
    "date-fns": "^4.1.0",
    "electron": "43.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "jotai": "^2.11.1",
    "jsdom": "^25.0.1",
    "katex": "^0.18.4",
    "lodash": "^4.17.21",
    "pdfjs-dist": "^6.2.108",
    "postcss": "^8.5.6",
    "prettier": "^3.0.2",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.9.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.10",
    "tw-animate-css": "^1.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0",
  "homepage": "https://github.com/Coderbeep/obim",
  "repository": {
    "type": "git",
    "url": "https://github.com/Coderbeep/obim.git"
  }
}
