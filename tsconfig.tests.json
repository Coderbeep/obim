{
  "extends": "./tsconfig.web.json",
  "include": ["src/renderer/src/env.d.ts", "src/preload/*.d.ts", "tests/**/*.ts", "tests/**/*.tsx"],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/main/*"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
